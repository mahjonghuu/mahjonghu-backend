# Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler.
# Use the transaction pooler for serverless deployments (port 6543).
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres

# NestJS HTTP port (optional; defaults to 3000)
PORT=3001

# CORS origin for the frontend (optional; defaults to http://localhost:3000)
WEB_ORIGIN=http://localhost:3000

# Generate a unique random secret of at least 32 characters. Required by the backend.
JWT_SECRET=mahjonghu-secret-123456789012345678901234567890