# Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler.
# Use the transaction pooler for serverless deployments (port 6543).
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres

# NestJS HTTP port (optional; defaults to 3000)
PORT=3001

# CORS origin for the frontend (optional; defaults to http://localhost:3000)
WEB_ORIGIN=http://localhost:3000

# Parent domain shared by the dashboard and API when hosted on separate subdomains.
# Leave unset locally; production mahjonghuu.com + api.mahjonghuu.com: mahjonghuu.com
OWNER_COOKIE_DOMAIN=

# Generate a unique random secret of at least 32 characters. Required by the backend.
JWT_SECRET=mahjonghu-secret-123456789012345678901234567890

# DOKU Checkout credentials; use separate merchant credentials per environment.
DOKU_DEV_CLIENT_ID=
DOKU_DEV_SECRET_KEY=
DOKU_PROD_CLIENT_ID=
DOKU_PROD_SECRET_KEY=

# Public origins required for DOKU browser return and server notification callbacks.
WEB_PUBLIC_URL=
BACKEND_PUBLIC_URL=

# Customer email OTP delivery via Resend; both required for member login.
RESEND_API_KEY=
EMAIL_FROM=

# Supabase Storage for outlet and advertisement images (required only for image operations).
# Create public buckets named below; allow public reads, but keep writes server-only.
# Backend-only credentials: never use NEXT_PUBLIC_ or expose the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OUTLET_PHOTOS_BUCKET=outlet-photos
SUPABASE_ADVERTISEMENT_IMAGES_BUCKET=advertisement-images